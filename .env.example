# HulioMed local configuration (example only - never commit the real .env)
#
# 1) Copy this file to a file named exactly:  .env
# 2) Paste your real Mistral API key on the line below.
#    (Get a free key at https://console.mistral.ai/ -> API Keys)
# 3) .env is ignored by git, so your key stays private.

MISTRAL_API_KEY=your-mistral-api-key-here

# Optional: which models to use (defaults shown)
# open-mistral-nemo works on the free tier; mistral-small-latest may rate-limit.
EMBEDDING_MODEL=mistral-embed
LLM_MODEL=open-mistral-nemo

# Optional: deployment settings (defaults shown keep local dev exactly as-is)
# HULIOMED_API_URL - backend the Streamlit UI talks to. Keep the local default
# for local dev; point it at your deployed API (e.g. https://my-api.onrender.com)
# when the UI is hosted separately.
HULIOMED_API_URL=http://127.0.0.1:8000
# CORS_ORIGINS - comma-separated list of browser origins allowed to call the
# API. "*" (default) allows any origin for this educational prototype.
CORS_ORIGINS=*